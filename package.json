{
  "name": "typefab",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:worker": "npm --prefix worker run dev",
    "db:local": "npm --prefix worker run db:local",
    "db:remote": "npm --prefix worker run db:remote",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "db:migrate:local": "npm --prefix worker run db:migrate:local",
    "db:migrate:remote": "npm --prefix worker run db:migrate:remote"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "harfbuzzjs": "^1.6.1",
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  }
}
